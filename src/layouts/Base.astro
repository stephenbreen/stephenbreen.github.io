---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { SITE_DESCRIPTION, SITE_TITLE } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  type?: 'website' | 'article';
}

const { title, description = SITE_DESCRIPTION, ogImage = '/og/site.png', type = 'website' } = Astro.props;
const fullTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title ?? SITE_TITLE} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#F5F1E6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1C1A16" media="(prefers-color-scheme: dark)" />

    <Font cssVariable="--font-newsreader" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-jetbrains-mono" preload />

    <script is:inline>
      // Apply a saved theme before first paint so there's no flash.
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a href="/" class="wordmark"><span>~</span>/stephenbreen</a>
        <nav class="site">
          <a href="/#made">made</a>
          <a href="/writing/">writing</a>
          <a href="/#day-job">day job</a>
          <a href="https://github.com/stephenbreen">github ↗</a>
          <button type="button" class="theme-toggle" aria-label="Switch between light and dark">
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
              <circle cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke-width="1.5" />
              <path d="M8 1.75a6.25 6.25 0 0 1 0 12.5z" fill="currentColor" />
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="site">
      <div class="wrap">
        <span>© {new Date().getFullYear()} Stephen Breen · Cork, Ireland</span>
        <span><a href="/rss.xml">rss</a> · <b>$</b> exit 0</span>
      </div>
    </footer>

    <script>
      const root = document.documentElement;
      document.querySelector('.theme-toggle')?.addEventListener('click', () => {
        const current =
          root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
      });
    </script>
  </body>
</html>
